{
  "manifest_version": 3,
  "name": "Visa Autofill",
  "version": "0.1.0",
  "description": "Smart Visa Application Autofill",
  "action": {
    "default_popup": "index.html",
    "default_title": "Visa Autofill"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://indianvisa-bangladesh.nic.in/visa/*",
        "https://indianvisa-bangladesh.nic.in/*",
        "https://indianvisaonline.gov.in/visa/*",
        "https://indianvisaonline.gov.in/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://indianvisa-bangladesh.nic.in/*",
    "https://indianvisaonline.gov.in/*",
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1:8001/*"
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "https://*/*",
        "http://*/*",
        "<all_urls>"
      ]
    }
  ]
}
