{
  "manifest_version": 3,
  "name": "Visa Autofill",
  "version": "0.1.0",
  "description": "Smart Visa Application Autofill",
  "action": {
    "default_popup": "index.html",
    "default_title": "Visa Autofill"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "tesseract/*",
        "pdfjs/*",
        "assets/*"
      ],
      "matches": [
        "https://*/*",
        "http://*/*",
        "<all_urls>"
      ]
    }
  ]
}
