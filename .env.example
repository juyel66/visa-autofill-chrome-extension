# Gemini API Key (get from Google AI Studio / Google Cloud)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
VITE_GOOGLE_REDIRECT_URI="https://<extension-id>.chromiumapp.org/"

# Backend API Base URL (Default: http://localhost:8000)
VITE_BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
# Production Render URL:
# VITE_BACKEND_URL=https://indian-visa-autofill-backend.onrender.com
# VITE_API_BASE_URL=https://indian-visa-autofill-backend.onrender.com

# Python Local OCR Extractor Service URL (Default: http://127.0.0.1:8001)
VITE_PYTHON_EXTRACTOR_URL=http://127.0.0.1:8001
